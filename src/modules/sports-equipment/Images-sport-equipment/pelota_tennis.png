k\":{\"message\":\"Aqui\",\"href\":\"\u002Fgarantia-extendida\",\"target\":\"_self\"}}}","contentIds":[""],"treePath":"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fchange-showcase-color#product-main\u002Fflex-layout.row#product-main\u002Fflex-layout.col#right-col\u002Fconditional-wrapper#product-main\u002Fflex-layout.row#product-main-wrapper\u002Fflex-layout.col#product-main-wrapper\u002Fcondition-layout.product#warranty__show_or_not\u002Fflex-layout.row#extended-warranty\u002Fextended-warranty.v2\u002Fslider-warranty-products"},{"contentJSON":"{\"blockClass\":\"slider-warranty-product-recommendations\",\"sliderTile\":\"**Complementa tu garantia**\",\"ModalLayout\":\"modal-layout#quickview__lanzamiento-agosto\",\"crossSellingType\":\"suggestions\",\"sliderProps\":{\"slideTransition\":{\"speed\":1000,\"delay\":0,\"timing\":\"ease\"},\"autoplay\":{\"timeout\":5000,\"stopOnHover\":true},\"itemsPerPage\":{\"desktop\":2,\"tablet\":2,\"phone\":1},\"centerMode\":{\"desktop\":\"disabled\",\"tablet\":\"disabled\",\"phone\":\"to-the-left\"},\"centerModeSlidesGap\":16,\"showNavigationArrows\":\"always\",\"showPaginationDots\":\"always\",\"infinite\":true,\"fullWidth\":true,\"arrowSize\":20}}","contentIds":[""],"treePath":"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fchange-showcase-color#product-main\u002Fflex-layout.row#product-main\u002Fflex-layout.col#right-col\u002Fconditional-wrapper#product-main\u002Fflex-layout.row#product-main-wrapper\u002Fflex-layout.col#product-main-wrapper\u002Fcondition-layout.product#warranty__show_or_not\u002Fflex-layout.row#extended-warranty\u002Fextended-warranty.v2\u002Fslider-warranty-product-recommendations"},{"contentJSON":"{}","contentIds":[""],"treePath":"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fflex-layout.row#product-main-availability\u002Fflex-layout.col#sta