esktop#product-suggestion\u002Fproduct-suggestions\u002Fmodal-layout#quickview__lanzamiento-agosto\u002Fflex-layout.row#quickview__lanzamiento-agosto-main-row\u002Fflex-layout.col#quickview__lanzamiento-agosto-product-details\u002Fmodal-content#quickview__lanzamiento-agosto\u002Fflex-layout.col#prices-pdp\u002Fproduct-list-price#pdp":{"before":[],"around":[],"after":[],"blockId":"panamericana.store-theme@3.x:product-list-price#pdp","blocks":[],"component":"vtex.product-price@1.31.2\u002FListPrice","composition":"children","hasContentSchema":true,"hydration":"always","implements":["vtex.product-price@1.x:product-list-price"],"preview":null,"props":{"blockClass":"product__list-price-pdp","message":"de: {listPriceValue}"},"render":"server","track":[],"content":{"blockClass":"product__list-price-pdp","message":"de: {listPriceValue}"},"contentIds":[""]},"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fchange-showcase-color#product-main\u002Fflex-layout.row#product-main\u002Fflex-layout.col#stack\u002Fresponsive-layout.desktop#product-suggestion\u002Fproduct-suggestions\u002Fmodal-layout#quickview__lanzamiento-agosto\u002Fflex-layout.row#quickview__lanzamiento-agosto-main-row\u002Fflex-layout.col#quickview__lanzamiento-agosto-product-details\u002Fmodal-content#quickview__lanzamiento-agosto\u002Fflex-layout.col#prices-pdp\u002Fproduct-selling-price#pdp":{"before":[],"around":[],"after":[],"blockId":"panamericana.store-theme@3.x:product-selling-price#pdp","blocks":[],"component":"vtex.product-price@1.31.2\u002FSellingPrice","composition":"children","hasContentSchema":true,"hydration":"always","implements":["vtex.product-price@1.x:product-selling-price"],"preview":null,"props":{"blockClass":"product__selling-price-pdp","message":"por: {sellingPriceValue}"},"render":"server","track":[],"content":{"blockClass":"product__selling-price-pdp","message":"por: {sellingPriceValue}"},"contentIds":[""]},"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fchange-showcase-color#product-main\u002Fflex-layout.row#product-main\u002Fflex-layout.col#stack\u002Fresponsive-layout.desktop#product-suggestion\u002Fproduct-suggestions\u002Fmodal-layout#quickview__lanzamiento-agosto\u002Fflex-layout.row#quickview__lanzamiento-agosto-main-row\u002Fflex-layout.col#quickview__lanzamiento-agosto-product-details\u002Fmodal-content#quickview__lanzamiento-agosto\u002Fflex-layout.col#prices-pdp\u002Fspecial-price#product--special-price":{"before":[],"around":[],"after":[],"blockId":"panamericana.store-theme@3.x:special-price#product--special-price","blocks":[],"component":"panamericana.store-general-components@0.4.17\u002FSpecialPrice","composition":"blocks","hasContentSchema":false,"hydration":"always","implements":["panamericana.store-general-components@0.x:special-price"],"preview":null,"props":{"blockClass":"product--special-price","priceConfigs":[{"__editorItemTitle":"15% TC Scotiabank Colpatria","collectionId":"8175","percentage":15,"activationConfig":{"startDate":"2024-03-19T00:00:00.000Z","endDate":"2024-03-25T00:00:00.000Z","manualActivation":true,"activationType":"dates"},"modalTitle":"**Pagando con todas las tarjetas de crédito Scotiabank Colpatria**","modalContent":"**Términos y condiciones:** \n- Promoción válida únicamente del 19 al 25 de marzo de 2024.\n- Aplica exclusivamente para compras realizadas con las tarjetas de crédito de Scotiabank Colpatria persona natural.\n\nMecánica de la promoción:\nEl cliente obtendrá un descuento adicional del 15% pagando con las tarjetas de crédito de  Scotiabank Colpatria persona natural, en la categoría de tecnología (computadores, tabletas, celulares, televisores, audífonos, impresoras, monitores, videoproyectores, parlantes, smartwatch, consolas, videojuegos, mouse, teclados, cartuchos de tinta, básculas, ventiladores y aspiradoras); NO APLICA para: cintas para impresoras, cintas para máquinas de escribir, papeles especiales, Data Cartridge, entintado de calculadoras, cintas para calculadoras, CD, DVD+, DVD-, memorias, lectores de tarjetas, celulares prepago, celulares pospago, tarjetas SIM, recargas para celular, elementos de limpieza, soportes para televisor, estuches para cámaras digitales, relojes digitales, tarjetas POSA, remanufacturados ni extensiones de garantía. No aplica para domicilios ni ventas corporativas. Máximo 2 unidades de productos de tecnología, videojuegos, consolas y productos en promoción del mismo código y\u002Fo referencia por cliente, por cédula, por factura, por tienda, por evento y por dirección de envío. La promoción aplica pagando la totalidad de la compra con las tarjetas de crédito Scotiabank Colpatria  persona natural, realizada en www.panamericana.com.co o en los puntos físicos. El descuento adicional de Colpatria aplica después de otros descuentos.\n\n®Marca registrada de The Bank of Nova Scotia, utilizada bajo licencia de Scotiabank Colpatria, establecimiento bancario bajo licencia de Scotiabank Colpatria Establecimiento Bancario. Campaña válida del 19 al 25 de marzo de 2024 o hasta agotar existencias, lo que primero ocurra. Aplica únicamente para las compras realizadas con tarjetas de crédito Scotiabank Colpatria persona natural. Scotiabank Colpatria no es vendedor, productor ni proveedor de ninguno de los productos ofrecidos por Panamericana, por lo que no es responsable por la calidad, idoneidad ni garantía de los mismos. Conoce las tasas y tarifas aplicables en [www.scotiabankcolpatria.com\u002Ftasas-y-tarifas](https:\u002F\u002Fwww.scotiabankcolpatria.com\u002Ftasas-y-tarifas?_target=_blank). Dando cumplimiento al literal E, del artículo 631 del Estatuto Tributario, el Banco Scotiabank Colpatria informará a la Dirección de Impuestos y Aduanas Nacionales - DIAN, el dinero que se entregue en esta campaña a cada cliente.","modalImageUrl":"https:\u002F\u002Fpanamericana.vteximg.com.br\u002Farquivos\u002Fpop-up-tercer-precio-panamericana.png","modalUrl":"\u002Flinks-interes\u002Fterminos-y-condiciones\u002F15dto-adicional-pagando-con-tarjetas-colpatria"}]},"render":"server","track":[],"content":{"blockClass":"product--special-price","priceConfigs":[{"__editorItemTitle":"15% TC Scotiabank Colpatria","collectionId":"8175","percentage":15,"activationConfig":{"startDate":"2024-03-19T00:00:00.000Z","endDate":"2024-03-25T00:00:00.000Z","manualActivation":true,"activationType":"dates"},"modalTitle":"**Pagando con todas las tarjetas de crédito Scotiabank Colpatria**","modalContent":"**Términos y condiciones:** \n- Promoción válida únicamente del 19 al 25 de marzo de 2024.\n- Aplica exclusivamente para compras realizadas con las tarjetas de crédito de Scotiabank Colpatria persona natural.\n\nMecánica de la promoción:\nEl cliente obtendrá un descuento adicional del 15% pagando con las tarjetas de crédito de  Scotiabank Colpatria persona natural, en la categoría de tecnología (computadores, tabletas, celulares, televisores, audífonos, impresoras, monitores, videoproyectores, parlantes, smartwatch, consolas, videojuegos, mouse, teclados, cartuchos de tinta, básculas, ventiladores y aspiradoras); NO APLICA para: cintas para impresoras, cintas para máquinas de escribir, papeles especiales, Data Cartridge, entintado de calculadoras, cintas para calculadoras, CD, DVD+, DVD-, memorias, lectores de tarjetas, celulares prepago, celulares pospago, tarjetas SIM, recargas para celular, elementos de limpieza, soportes para televisor, estuches para cámaras digitales, relojes digitales, tarjetas POSA, remanufacturados ni extensiones de garantía. No aplica para domicilios ni ventas corporativas. Máximo 2 unidades de productos de tecnología, videojuegos, consolas y productos en promoción del mismo código y\u002Fo referencia por cliente, por cédula, por factura, por tienda, por evento y por dirección de envío. La promoción aplica pagando la totalidad de la compra con las tarjetas de crédito Scotiabank Colpatria  persona natural, realizada en www.panamericana.com.co o en los puntos físicos. El descuento adicional de Colpatria aplica después de otros descuentos.\n\n®Marca registrada de The Bank of Nova Scotia, utilizada bajo licencia de Scotiabank Colpatria, establecimiento bancario bajo licencia de Scotiabank Colpatria Establecimiento Bancario. Campaña válida del 19 al 25 de marzo de 2024 o hasta agotar existencias, lo que primero ocurra. Aplica únicamente para las compras realizadas con tarjetas de crédito Scotiabank Colpatria persona natural. Scotiabank Colpatria no es vendedor, productor ni proveedor de ninguno de los productos ofrecidos por Panamericana, por lo que no es responsable por la calidad, idoneidad ni garantía de los mismos. Conoce las tasas y tarifas aplicables en [www.scotiabankcolpatria.com\u002Ftasas-y-tarifas](https:\u002F\u002Fwww.scotiabankcolpatria.com\u002Ftasas-y-tarifas?_target=_blank). Dando cumplimiento al literal E, del artículo 631 del Estatuto Tributario, el Banco Scotiabank Colpatria informará a la Dirección de Impuestos y Aduanas Nacionales - DIAN, el dinero que se entregue en esta campaña a cada cliente.","modalImageUrl":"https:\u002F\u002Fpanamericana.vteximg.com.br\u002Farquivos\u002Fpop-up-tercer-precio-panamericana.png","modalUrl":"\u002Flinks-interes\u002Fterminos-y-condiciones\u002F15dto-adicional-pagando-con-tarjetas-colpatria"}]},"contentIds":[""]},"store.product\u002Forganizador-dinamico-wrapper#product\u002Fcondition-layout.product#availability\u002Fchange-showcase-color#product-main\u002Fflex-layout.row#product-main\u002Fflex-layout.col#stack\u002Fresponsive-layout.desktop#product-suggestion\u002Fproduct-suggestions\u002Fmodal-layout#quickview__lanzamiento-agosto\u002Fflex-layout.row#quickview__lanzamiento-agosto-main-row\u002Fflex-layout.col#quickview__lanzamiento-agosto-product-details\u002Fmodal-content#quickview__lanzamiento-agosto\u002Fflex-layout.col#prices-pdp\u002Fmz-unit-price":{"before":[],"around":[],"after":[],"blockId":"panamer